# Règles R8 de Sceau. AGP combine tous les fichiers de src/main/keepRules.
# Voir https://d.android.com/r/tools/r8/keep-rules

# BouncyCastle : le fournisseur JCA enregistre ses implémentations (Cipher, Signature,
# KeyAgreement, CertificateFactory…) par nom de classe sous forme de chaîne et les instancie
# par réflexion. Sans ces règles, R8 les retire et Signature.getInstance(…, "BC") échoue.
-keep class org.bouncycastle.jcajce.provider.** { *; }
-keep class org.bouncycastle.jce.provider.** { *; }

# JMRTD, SCUBA et cert-cvc (dépendance de JMRTD pour les certificats CV) : conservés en
# entier, car ils s'appuient eux aussi sur des noms d'algorithmes et de fournisseurs JCA
# résolus à l'exécution. Leur taille est modeste.
-keep class org.jmrtd.** { *; }
-keep class net.sf.scuba.** { *; }
-keep class org.ejbca.cvc.** { *; }

# BouncyCastle référence JNDI (javax.naming) pour les magasins LDAP et DANE, absents
# d'Android et jamais utilisés par Sceau.
-dontwarn javax.naming.**
