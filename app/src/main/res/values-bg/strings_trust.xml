<resources>
    <string name="trust_title">Доверени сертификати</string>
    <string name="trust_back">Назад</string>
    <string name="trust_intro">Основни сертификати (CSCA) на издаващите държави, с които се проверява подписът на документите. На този екран не се обработват лични данни.</string>
    <plurals name="trust_summary">
        <item quantity="one">%1$d сертификат, държави: %2$d</item>
        <item quantity="other">%1$d сертификата, държави: %2$d</item>
    </plurals>
    <string name="trust_loading">Зареждане на доверените сертификати…</string>
    <string name="trust_load_error">Доверените сертификати не могат да бъдат заредени.</string>
    <string name="trust_retry">Нов опит</string>
    <string name="trust_empty">Няма доверени сертификати.</string>

