    <!-- Import -->
    <string name="trust_import">Импортиране на Master List</string>
    <string name="trust_busy">Моля, изчакайте…</string>
    <string name="trust_import_confirm_title">Да се импортира ли този Master List?</string>
    <string name="trust_import_confirm_text">Подписът му е валиден. Преди да го импортирате, проверете дали отпечатъкът на подписващия съвпада с публикувания от издаващия орган.</string>
    <string name="trust_import_signer">Подписващ</string>
    <string name="trust_import_signer_fingerprint">Отпечатък SHA-256 на подписващия</string>
    <string name="trust_import_signing_date">Дата на подписване</string>
    <string name="trust_import_signing_date_unknown">Не е посочена</string>
    <string name="trust_import_certificate_count">Брой сертификати</string>
    <string name="trust_import_confirm">Импортиране</string>
    <string name="trust_cancel">Отказ</string>
    <plurals name="trust_import_done">
        <item quantity="one">Master List е импортиран: %1$d сертификат.</item>
        <item quantity="other">Master List е импортиран: %1$d сертификата.</item>
    </plurals>
    <string name="trust_import_invalid">Този файл не е валиден Master List: форматът е нечетлив или подписът е неправилен (%1$s).</string>
    <string name="trust_import_too_large">Файлът е отхвърлен: надвишава 20 МБ.</string>
    <string name="trust_import_read_error">Файлът не може да бъде прочетен.</string>
    <string name="trust_import_write_error">Master List не може да бъде запазен.</string>
    <plurals name="trust_import_limit_count">
        <item quantity="one">Импортирането е отказано: може да се импортира най-много %1$d Master List. Изтрийте импортираните сертификати, за да добавите друг.</item>
        <item quantity="other">Импортирането е отказано: могат да се импортират най-много %1$d Master List. Изтрийте импортираните сертификати, за да добавите друг.</item>
    </plurals>
    <string name="trust_import_limit_size">Импортирането е отказано: импортираните Master List биха надвишили общо %1$d МБ. Изтрийте импортираните сертификати, за да добавите друг.</string>

