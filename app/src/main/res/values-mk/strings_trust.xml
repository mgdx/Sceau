    <string name="trust_intro">Коренски сертификати (CSCA) на државите издавачи, со кои се проверува потписот на документите. Низ овој екран не минуваат лични податоци.</string>
    <plurals name="trust_summary">
        <item quantity="one">%1$d сертификат, држави: %2$d</item>
        <item quantity="other">%1$d сертификати, држави: %2$d</item>
    </plurals>
    <string name="trust_loading">Се вчитуваат доверливите сертификати…</string>
    <string name="trust_load_error">Доверливите сертификати не може да се вчитаат.</string>
    <string name="trust_retry">Обиди се повторно</string>
