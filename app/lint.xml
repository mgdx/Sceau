<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        bcpkix ships, in the org.bouncycastle.est package, an "accept everything" TLS trust manager
        meant for the EST protocol (RFC 7030). Sceau has no network permission, does not use EST
        and R8 removes these classes in release. The exclusion targets this jar only.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/bcpkix-jdk18on-*.jar" />
    </issue>
</lint>
